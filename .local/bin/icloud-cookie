#!/bin/bash
set -e

RCLONE_CONF="$HOME/.config/rclone/rclone.conf"
TEMP_PROFILE=$(mktemp -d)
trap 'rm -rf "$TEMP_PROFILE"' EXIT

# Select iCloud remote
mapfile -t remotes < <(awk '/^\[.*\]$/{name=substr($0,2,length($0)-2)} /^type *= *iclouddrive *$/{print name}' "$RCLONE_CONF")
[[ ${#remotes[@]} -eq 0 ]] && { echo "Error: no iclouddrive remotes found"; exit 1; }

if [[ ${#remotes[@]} -eq 1 ]]; then
    REMOTE="${remotes[0]}"
    echo "Selected remote: $REMOTE"
else
    printf '%s\n' "${remotes[@]}"
    read -p "Remote name: " REMOTE
    [[ " ${remotes[*]} " =~ " $REMOTE " ]] || { echo "Error: invalid remote '$REMOTE'"; exit 1; }
fi

# Open Firefox and wait for user to login
echo "Login to iCloud in Firefox..."
echo 'user_pref("datareporting.policy.firstRunURL", "");' > "$TEMP_PROFILE/user.js"
firefox -no-remote -profile "$TEMP_PROFILE" "https://www.icloud.com/" 2>/dev/null
wait

# Extract cookies
COOKIES_DB="$TEMP_PROFILE/cookies.sqlite"
get_cookie() { sqlite3 "$COOKIES_DB" "SELECT value FROM moz_cookies WHERE name='$1';" 2>/dev/null || true; }

user=$(get_cookie "X-APPLE-WEBAUTH-USER")
token=$(get_cookie "X-APPLE-WEBAUTH-TOKEN")
documents=$(get_cookie "X-APPLE-WEBAUTH-PCS-Documents")
trust=$(get_cookie "X-APPLE-WEBAUTH-HSA-TRUST")

[[ -z "$user" || -z "$token" ]] && { echo "Error: required cookies not found"; exit 1; }

# Update rclone config
awk -v remote="[$REMOTE]" \
    -v cookies="cookies = X-APPLE-WEBAUTH-TOKEN=$token;X-APPLE-WEBAUTH-USER=$user;X-APPLE-WEBAUTH-PCS-Documents=$documents;" \
    -v trust="trust_token = $trust" '
    $0 == remote { in_section=1; print; next }
    /^\[.*\]$/ && in_section { 
        if (!updated) print cookies "\n" trust "\n"
        in_section=0; updated=0 
    }
    in_section && /^(cookies|trust_token) *=/ { 
        if (!updated) { print cookies; print trust; updated=1 }
        next 
    }
    { print }
    END { if (in_section && !updated) print cookies "\n" trust }
' "$RCLONE_CONF" > "$RCLONE_CONF.tmp" && mv "$RCLONE_CONF.tmp" "$RCLONE_CONF"

echo "Successfully updated '$REMOTE' with iCloud cookies"
