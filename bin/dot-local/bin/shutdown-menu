#!/bin/sh

case $(printf 'zzz\nkill\nlogout\nreboot\nshutdown' |
  dmenu -i -c -l 5 -W 0.2 -p 'Select action:') in
  zzz) systemctl suspend -i ;;
  kill) ps -u "$USER" -o pid,comm,%cpu,%mem |
    dmenu -c -l 10 -W 0.4 -p 'Kill:' |
    awk '{print $1}' |
    xargs -r kill ;;
  logout) loginctl terminate-user $USER ;;
  reboot) systemctl reboot ;;
  shutdown) systemctl poweroff ;;
  *) exit 1 ;;
esac
