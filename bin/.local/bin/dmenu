#!/bin/sh

HEIGHT=27
PADDING=13
FONT="IosevkaCustomNerdFont 11"
BACKGROUND="#1A1B26"
FOREGROUND="#BB9AF7"
FILTER="#E0AF68"
TEXT="#C0CAF5"
HIGHLIGHT_BACKGROUND="#414868"
HIGHLIGHT_FOREGROUND="#7DCFFF"
/usr/bin/bemenu "$@" -H "$HEIGHT" --hp "$PADDING" --fn "$FONT" \
  --tb "$BACKGROUND" --tf "$FOREGROUND" --fb "$BACKGROUND" --ff "$FILTER" \
  --nb "$BACKGROUND" --nf "$TEXT" --ab "$BACKGROUND" \
  --af "$TEXT" --hb "$HIGHLIGHT_BACKGROUND" --hf "$HIGHLIGHT_FOREGROUND"
