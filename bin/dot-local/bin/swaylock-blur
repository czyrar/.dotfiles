#!/bin/sh

# Base part
options=$(cat <<'EOF'
--show-failed-attempts
--daemonize
--show-keyboard-layout
--indicator-caps-lock
--scaling=fill
--font=IosevkaNerdFont
--font-size=24
--indicator-radius=100
--indicator-thickness=20
--inside-color=ffffff88
--inside-clear-color=ffffff88
--inside-caps-lock-color=f5c86188
--inside-ver-color=c5e66588
--inside-wrong-color=ff7b8e88
--key-hl-color=e0b8ffff
--layout-bg-color=181818ff
--layout-border-color=181818ff
--layout-text-color=ffffffff
--ring-color=a8f0d8ff
--ring-clear-color=a8f0d8ff
--ring-ver-color=c5e665ff
--ring-wrong-color=ff7b8eff
--separator-color=e0b8ffff
--text-color=181818ff
--text-clear-color=181818ff
--text-caps-lock-color=181818ff
--text-ver-color=181818ff
--text-wrong-color=181818ff
EOF
)

# Background
cache_dict="$HOME/.cache/swaylock"
[ -d "$cache_dict" ] || mkdir -p "$cache_dict"
while read -r line; do
  output=$(printf "%s" "$line" | cut -d' ' -f1)
  wallpaper=$(printf "%s" "$line" | cut -d' ' -f2)
  lockpaper="$cache_dict/$(basename $wallpaper)"
  [ -f "$lockpaper" ] || magick "$wallpaper" -filter Gaussian -resize 2.5% -define filter:sigma=2.5 -resize 4000% "$lockpaper"
  options="${options} --image ${output}${lockpaper}"
done <<-EOF
$(awww query | cut -d' ' -f2,9)
EOF

swaylock $options
