output eDP-1 {
  position 0 0
  resolution 1920x1200@60.001Hz
}

input type:keyboard {
  xkb_layout "us,es"
  xkb_variant "altgr-intl,winkeys"
  xkb_options "grp:shift_caps_toggle"
  repeat_rate 35
  repeat_delay 200
}

input type:pointer {
  accel_profile "flat"
  pointer_accel 0
}

input type:touchpad {
  tap enabled
  natural_scroll enabled
}

input type:tablet_tool {
  map_to_output eDP-1
}

exec "kanshi"
