#!/bin/sh

folder=$HOME/Documents/notes/
[ -d $folder ] || mkdir $folder

newnote () { \
  name="$(echo '' | bemenu-themed -c -p 'Enter a name: ')" || exit 0
  : "${name:=$(date +%F_%H-%M-%S)}"
  setsid -f "$TERMINAL" -e nvim "$folder/$name.md" >/dev/null 2>&1
}

selected () { \
  choice=$(
    printf "New\n$(find $folder -type f -printf '%T@ %P\n' | sort -nr | cut -d' ' -f2-)" | bemenu-themed -c -l 5 -i -W 0.4 -p "Choose note or create new: "
  )
  case $choice in
    New) newnote ;;
    *.md) setsid -f "$TERMINAL" -e nvim "$folder/$choice" >/dev/null 2>&1 ;;
    *) exit ;;
  esac
}

selected
