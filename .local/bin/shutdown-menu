#!/bin/sh

case $(printf 'zzz\nkill\nreboot\nshutdown' |
  bemenu-themed -c -l 4 -W 0.2 -p 'Select action:') in
  zzz) systemctl suspend -i ;;
  kill) ps -u "$USER" -o pid,comm,%cpu,%mem |
    bemenu-themed -c -l 10 -W 0.4 -p 'Kill:' |
    awk '{print $1}' |
    xargs -r kill ;;
  reboot) systemctl reboot ;;
  shutdown) systemctl poweroff ;;
  *) exit 1 ;;
esac
